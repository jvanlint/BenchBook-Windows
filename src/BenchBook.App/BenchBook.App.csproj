<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>BenchBook.App</RootNamespace>
    <AssemblyName>BenchBook</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- The Windows App SDK runtime ships inside the package, so a direct download needs nothing else installed. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\BenchBook.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    A release can also be built as a plain folder with BenchBook.exe, for a zip
    download that needs no signing: -p:BenchBookUnpackaged=true (build\Release.ps1).
    Without a package there's no share target, but it can update itself (CLAUDE.md, "Updates").
  -->
  <PropertyGroup Condition="'$(BenchBookUnpackaged)' == 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied next to the app, where the registered package and its resource index look for them. -->
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\BenchBook.ico" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Markdown parsing for the Markdown viewer (BSD-2). Drawn with WinUI's own text elements. -->
    <PackageReference Include="Markdig" Version="1.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BenchBook.Core\BenchBook.Core.csproj" />
    <ProjectReference Include="..\BenchBook.Pdf\BenchBook.Pdf.csproj" />
  </ItemGroup>

</Project>
