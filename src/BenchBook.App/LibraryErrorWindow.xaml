<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BenchBook.App.LibraryErrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BenchBook">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <StackPanel MaxWidth="520" Margin="32" VerticalAlignment="Center" Spacing="12">
        <FontIcon Glyph="&#xE7BA;" FontSize="40" HorizontalAlignment="Left" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
        <TextBlock Text="Can't Open Your Library" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        <TextBlock Text="BenchBook didn't change any of your data. Close and reopen the app to try again." TextWrapping="Wrap" />
        <Button Content="Show Library in Explorer" Click="ShowLibrary_Click" Margin="0,8,0,0" />
    </StackPanel>
</Window>
