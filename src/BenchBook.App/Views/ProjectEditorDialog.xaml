<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="BenchBook.App.Views.ProjectEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="Save_Click">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MinWidth="400">
            <TextBox x:Name="NameBox" Header="Name" PlaceholderText="Required" TextChanged="Name_TextChanged" />
            <TextBox x:Name="ManufacturerBox" Header="Manufacturer" PlaceholderText="e.g. Tamiya" />
            <TextBox x:Name="SubjectBox" Header="Subject" PlaceholderText="e.g. F-16CJ Block 50" />
            <TextBox x:Name="ScaleBox" Header="Scale" PlaceholderText="e.g. 1:48" />
            <TextBox x:Name="KitNumberBox" Header="Kit Number" PlaceholderText="Optional" />
            <TextBox x:Name="MarkingsBox" Header="Markings Scheme" PlaceholderText="Optional" />
            <ComboBox x:Name="StatusBox" Header="Status" MinWidth="200" />
            <TextBox x:Name="NotesBox" Header="Notes" PlaceholderText="Optional"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="220"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <TextBlock x:Name="NameHint" Text="Enter a name to save the project."
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
