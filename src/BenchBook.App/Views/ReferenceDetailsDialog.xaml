<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="BenchBook.App.Views.ReferenceDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Reference Details"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="Save_Click">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Spacing="12" MinWidth="480" Padding="0,0,12,0">
            <TextBox x:Name="TitleBox" Header="Title" />
            <TextBox x:Name="TagsBox" Header="Tags" PlaceholderText="Separate tags with commas" />
            <TextBox x:Name="NoteBox" Header="Note" PlaceholderText="Optional" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="72" MaxHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <StackPanel x:Name="TextSection" Spacing="4" Visibility="Collapsed">
                <TextBlock Text="Text" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="10" MaxHeight="220">
                    <ScrollViewer>
                        <TextBlock x:Name="CapturedText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <StackPanel x:Name="LinkSection" Spacing="6" Visibility="Collapsed">
                <TextBlock x:Name="LinkHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Image x:Name="Poster" MaxHeight="200" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed" />
                <TextBlock x:Name="LinkStatus" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                <Grid x:Name="LinkRows" ColumnSpacing="16" RowSpacing="4" />
                <Expander x:Name="DescriptionExpander" Header="Description" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Visibility="Collapsed">
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Expander>
            </StackPanel>

            <StackPanel x:Name="MomentsSection" Spacing="4" Visibility="Collapsed">
                <TextBlock Text="Moments" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel x:Name="MomentLinks" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Information" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid x:Name="InfoRows" ColumnSpacing="16" RowSpacing="4" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
