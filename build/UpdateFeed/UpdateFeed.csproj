<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Makes the Windows update key, and writes and signs the update feeds for a
    release (CLAUDE.md, "Releasing"). It uses BenchBook.Core's UpdateFeed, so
    the feeds are written by the same code that reads them.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BenchBook.Core\BenchBook.Core.csproj" />
  </ItemGroup>

</Project>
